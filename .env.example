# Copy to .env and fill in. Never commit .env.
# Values shared by both services must match (EMBEDDING_DIM, RAG_INTERNAL_TOKEN, storage).

# ---------------------------------------------------------------- shared
# development | production
APP_ENV=development
LOG_LEVEL=info
# Generate with: openssl rand -hex 32
RAG_INTERNAL_TOKEN=change-me-to-a-long-random-string-0123456789
# Must match the embedding model. Set before the first migration (changing it later
# needs a new migration and a re-embed of all documents).
EMBEDDING_DIM=1536
# local (dev only) | gcs
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/uploads
GCS_BUCKET=
# optional, e.g. redis://redis:6379/0 (shared cache + rate limits)
REDIS_URL=

# ---------------------------------------------------------------- api (Go)
PORT=8080
# docker compose: host port for the API (use 8081 if 8080 is taken)
API_PORT=8080
DATABASE_URL=postgres://horizonvalley:horizonvalley@localhost:5432/horizonvalley?sslmode=disable
# docker compose: host port for Postgres (use 5433 if a local Postgres owns 5432)
DB_PORT=5432
MIGRATE_ON_START=true
# dashboard + widget iframe origin
WEB_ORIGIN=http://localhost:3000
# extra dashboard origins (comma separated), usually empty
CORS_ORIGINS=
# CIDRs of proxies allowed to set X-Forwarded-For
TRUSTED_PROXIES=
# Generate each with: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# true in production (HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
# browser-visible path of the auth routes (via the web rewrite)
COOKIE_PATH=/api/v1/auth
RAG_URL=http://localhost:8000
# Cloud Run: rag URL, to also authenticate with IAM ID tokens
RAG_ID_TOKEN_AUDIENCE=
# Models bots may use, as <provider>:<model>. "openrouter:" = OpenRouter, "openai:" = OpenAI
# (or OPENAI_BASE_URL), bare "claude-*" = Anthropic. Add more later, e.g.
# ALLOWED_MODELS=openrouter:openai/gpt-4o-mini,claude-haiku-5-5,openai:gpt-4.1-mini
ALLOWED_MODELS=openrouter:openai/gpt-4o-mini
DEFAULT_MODEL=openrouter:openai/gpt-4o-mini
CHAT_HISTORY_TURNS=6
MAX_UPLOAD_MB=20
MAX_BOTS_PER_USER=20
MAX_DOCS_PER_BOT=500

# ---------------------------------------------------------------- rag (Python)
# Offline development without any API key: EMBEDDING_PROVIDER=hash and LLM_PROVIDER=fake.
# sent to OpenRouter as the app title
APP_NAME="Horizon Valley"

# OpenRouter: one key for chat models from many vendors (https://openrouter.ai/keys).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# optional, your public site URL (OpenRouter attribution)
OPENROUTER_SITE_URL=

# openrouter | openai (any OpenAI-compatible endpoint) | voyage | hash
EMBEDDING_PROVIDER=openrouter
# OpenRouter ids are vendor/model; with EMBEDDING_PROVIDER=openai use text-embedding-3-small
EMBEDDING_MODEL=openai/text-embedding-3-small

# Future providers (leave empty until used)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
VOYAGE_API_KEY=
# auto (by model name) | fake
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
# low keeps chat answers fast and cheap
LLM_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=2048
RETRIEVAL_TOP_K=5
# tune per embedding model
RETRIEVAL_MIN_SIMILARITY=0.25
CONTEXT_TOKEN_BUDGET=3000
HISTORY_TOKEN_BUDGET=1500
WORKER_CONCURRENCY=2
