# Copy to .env and fill in. Never commit .env.
# Values shared by both services must match (EMBEDDING_DIM, RAG_INTERNAL_TOKEN, storage).

# ---------------------------------------------------------------- shared
APP_ENV=development                 # development | production
LOG_LEVEL=info
# Generate with: openssl rand -hex 32
RAG_INTERNAL_TOKEN=change-me-to-a-long-random-string-0123456789
# Must match the embedding model. Set before the first migration (changing it later
# needs a new migration and a re-embed of all documents).
EMBEDDING_DIM=1536
STORAGE_DRIVER=local                # local (dev only) | gcs
LOCAL_STORAGE_DIR=./data/uploads
GCS_BUCKET=
REDIS_URL=                          # optional, e.g. redis://redis:6379/0 (shared cache + rate limits)

# ---------------------------------------------------------------- api (Go)
PORT=8080
DATABASE_URL=postgres://peakchat:peakchat@localhost:5432/peakchat?sslmode=disable
MIGRATE_ON_START=true
WEB_ORIGIN=http://localhost:3000    # dashboard + widget iframe origin
CORS_ORIGINS=                       # extra dashboard origins (comma separated), usually empty
TRUSTED_PROXIES=                    # CIDRs of proxies allowed to set X-Forwarded-For
# Generate each with: openssl rand -base64 48
JWT_SECRET=
OTP_PEPPER=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
COOKIE_SECURE=false                 # true in production (HTTPS)
COOKIE_SAMESITE=strict
COOKIE_PATH=/api/v1/auth            # browser-visible path of the auth routes (via the web rewrite)
RAG_URL=http://localhost:8000
RAG_ID_TOKEN_AUDIENCE=              # Cloud Run: rag URL, to also authenticate with IAM ID tokens
ALLOWED_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
DEFAULT_MODEL=claude-opus-5-5
CHAT_HISTORY_TURNS=6
MAX_UPLOAD_MB=20
MAX_BOTS_PER_USER=20
MAX_DOCS_PER_BOT=500

# Email: Gmail SMTP with a Google App Password (Google Account → Security →
# 2-Step Verification → App passwords). STARTTLS on 587 is required.
# Set MAIL_DRIVER=log during local development to print codes to the api log instead.
MAIL_DRIVER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=roadyridge@gmail.com
SMTP_PASS=
SMTP_FROM=roadyridge@gmail.com
MAIL_FROM_NAME=PeakChat
APP_NAME=PeakChat

# ---------------------------------------------------------------- rag (Python)
# Offline development without any API key: EMBEDDING_PROVIDER=hash and LLM_PROVIDER=fake.
EMBEDDING_PROVIDER=openai           # openai (any OpenAI-compatible endpoint) | voyage | hash
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
VOYAGE_API_KEY=
LLM_PROVIDER=auto                   # auto (by model name) | fake
ANTHROPIC_API_KEY=
LLM_EFFORT=low                      # low keeps chat answers fast and cheap
LLM_MAX_OUTPUT_TOKENS=2048
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.25       # tune per embedding model
CONTEXT_TOKEN_BUDGET=3000
HISTORY_TOKEN_BUDGET=1500
WORKER_CONCURRENCY=2
